# Port the server binds to. Cloud Run / Render / Fly all inject this.
PORT=8080

# Upstream vehicle-info service.
UPSTREAM_BASE_URL=https://insurance-webhook-945894769129.us-central1.run.app

# How long to wait for the upstream before giving up (ms).
# Keep this comfortably below the caller's own timeout so we return a
# proper error envelope instead of going silent.
UPSTREAM_TIMEOUT_MS=5000

# Extra attempts after the first, on timeout / 5xx only. Never on 4xx.
UPSTREAM_RETRIES=1

# Requests per minute per IP, applied to /api only.
RATE_LIMIT_MAX=60

# debug | info | warn | error
LOG_LEVEL=info

# Comma-separated origins, or * for any.
CORS_ORIGIN=*
